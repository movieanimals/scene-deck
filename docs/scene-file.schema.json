{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scene Deck portable scene version 1",
  "type": "object", "additionalProperties": false,
  "required": ["format", "version", "name", "groupLabel", "lights"],
  "properties": {
    "format": {"const": "scene-deck.scene"}, "version": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 32},
    "groupLabel": {"type": "string", "minLength": 1, "maxLength": 64},
    "lights": {"type": "array", "minItems": 1, "maxItems": 50, "items": {
      "type": "object", "additionalProperties": false, "required": ["slot", "label", "state"],
      "properties": {
        "slot": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,32}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 64},
        "state": {"type": "object", "additionalProperties": false, "required": ["on"], "not": {"required": ["xy", "mirek"]},
          "properties": {
            "on": {"type": "boolean"}, "brightness": {"type": "number", "minimum": 0, "maximum": 100},
            "mirek": {"type": "integer", "minimum": 153, "maximum": 500},
            "xy": {"type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}}
          }
        }
      }
    }}
  }
}
